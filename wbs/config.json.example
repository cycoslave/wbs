{
  "bot": {
    "nick": "WBS",
    "user": "wbs",
    "realname": "WBS IRC Bot",
    "servers": [
      {"host": "irc.example.com", "port": 6697, "password": null, "ssl": true }
    ],
    "channels": ["#channel", "#channel2"]
  },
  "users": [
    {
      "handle": "owner",
      "password": {
        "pass": "$2b$12$examplehashexamplehashexamplehashexamplehashexampleha1",
        "encryption": "bcrypt"
      },
      "hosts": ["owner!user@host.example.com"],
      "access": [
        {"is_admin": 1}
      ]
    },
    {
      "handle": "user2",
      "password": {
        "pass": "$2b$12$examplehashexamplehashexamplehashexamplehashexampleha2", 
        "encryption": "bcrypt"
      },
      "hosts": ["user2!user2@another.example.com"],
      "access": [
        {"is_op": 1, "channel": "#randomchannel", "subnet": 1}
      ]
    }
  ],
  "subnet": {
      "id": 1,
      "name": "default"
  },
  "botnet": {
      "address": "your.host.example",
      "listen_host": "127.0.0.1",
      "listen_port": 3333,
      "relay_from": {}
  },
  "db": {
    "path": "db/wbs.db"
  },
  "logging": {
    "level": "INFO",
    "file": "logs/wbs.log",
    "max_bytes": 10485760,
    "backup_count": 5
  },
  "plugins": [],
  "pubcom": {
    "channels": []
  },
  "dcc": {
    "enabled": true,
    "mode": "auto",
    "public_ip": "",
    "listen_host": "127.0.0.1",
    "port_min": 40000,
    "port_max": 40100,
    "max_sessions": 10,
    "max_pending": 5,
    "rate_limit": 3,
    "global_rate_limit": 20,
    "allow_networks": [],
    "auth_timeout": 60,
    "auth_attempts": 3
  },
  "update": {
    "host": "https://wbsupdate.wcksoft.com",
    "signing_keys": [],
    "auto_updates": false
  },
  "settings": {
    "pid_file": "wbs.pid",
    "ssl": true,
    "ssl_verify": true,
    "ssl_ca_file": null,
    "ssl_fingerprint": null,
    "certfile": "wbs.crt",
    "keyfile":  "wbs.key",
    "auto_update": false,
    "msg_commands": false,
    "irc_throttle_ms": 100,
    "access_mode": "blacklist",
    "max_failures": 5,
    "lockout_seconds": 300,
    "handshake_timeout": 30,
    "max_connections": 10
  }
}
