import argparse
import asyncio
import json
import logging
import os
import sys
from pathlib import Path
from multiprocessing import Process, Queue
from multiprocessing.connection import wait as mp_wait

from src import __version__
from src.core import Core
from src.irc import irc_process_launcher
from src.core import core_process_launcher 

logging.basicConfig(level=logging.INFO, format='%(asctime)s %(levelname)s %(message)s')
log = logging.getLogger("wbs")
EXIT_OK = 0

def parse_args():
    parser = argparse.ArgumentParser(prog="wbs")
    parser.add_argument("-c", "--config", default="config.json",
                        help="Path to config file")
    parser.add_argument("-d", "--db-path",
                        help="Override database path from config")
    parser.add_argument("-f", "--foreground", action="store_true",
                        help="Run in foreground with console")
    parser.add_argument("-p", "--mkpasswd", action="store_true",
                        help="Interactively prompt for a password and print its bcrypt hash. "
                            "Use the output in config.json with encryption=bcrypt.")
    parser.add_argument("-s", "--seed", action="store_true",
                        help="Initialize the database and seed from config.json, then exit. "
                            "Must be run once before first launch.")
    parser.add_argument("--pidfile", default=None,
                        help="Override pid file path (default: from config settings.pid_file)")
    parser.add_argument("--logfile", default=None,
                        help="Override log file path (default: from config logging.file)")
    return parser.parse_args()

def daemonize(logfile: str = "logs/wbs.log"):
    """Double-fork daemonize to fully detach from terminal."""
    if os.fork():
        sys.exit(0)
    os.setsid()
    if os.fork():
        sys.exit(0)
    os.makedirs(os.path.dirname(logfile) or '.', exist_ok=True)
    sys.stdin  = open(os.devnull, 'r')
    log_fh     = open(logfile, 'a')
    sys.stdout = log_fh
    sys.stderr = log_fh

def write_pidfile(path: str):
    try:
        with open(path, 'w') as f:
            f.write(str(os.getpid()))
        log.info(f"PID file written: {path}")
    except OSError as e:
        log.warning(f"Could not write PID file {path}: {e}")

def remove_pidfile(path: str):
    try:
        os.remove(path)
    except OSError:
        pass

def _spawn_core(config, config_path, args, core_q, irc_q) -> Process:
    p = Process(
        target=core_process_launcher,
        args=(config, config_path, args, core_q, irc_q),
        daemon=False,
        name="Core"
    )
    p.start()
    return p

def _spawn_irc(config, core_q, irc_q) -> Process:
    p = Process(
        target=irc_process_launcher,
        args=(config, core_q, irc_q, None),  # no parent pid needed
        daemon=False,
        name="IRC"
    )
    p.start()
    return p

def main():
    args = parse_args()

    if args.mkpasswd:
        import bcrypt, getpass
        pw = getpass.getpass("Password: ")
        print(bcrypt.hashpw(pw.encode(), bcrypt.gensalt()).decode())
        return

    config_path = Path(args.config)
    if not config_path.exists():
        print(f"ERROR: config file not found: {args.config}", file=sys.stderr)
        print("       Copy config.json.example to config.json and edit it first.", file=sys.stderr)
        sys.exit(1)

    try:
        with open(config_path) as f:
            config = json.load(f)
    except json.JSONDecodeError as e:
        sys.exit(f"[fatal] Config parse error in {args.config}: {e}")
    except OSError as e:
        sys.exit(f"[fatal] Cannot read config {args.config}: {e}")

    _log_cfg = config.get('logging', {})
    _level   = getattr(logging, _log_cfg.get('level', 'INFO').upper(), logging.INFO)
    _logfile = args.logfile or _log_cfg.get('file', 'logs/wbs.log')

    if args.foreground:
        logging.basicConfig(
            level=_level,
            format='%(asctime)s %(levelname)s %(message)s',
            stream=sys.stdout
        )
    else:
        os.makedirs(os.path.dirname(_logfile) or '.', exist_ok=True)
        logging.basicConfig(
            level=_level,
            format='%(asctime)s %(levelname)s %(message)s',
            filename=_logfile,
            filemode='a'
        )

    # Apply CLI overrides into the config dict so Core sees them
    if args.db_path:
        config.setdefault('db', {})['path'] = args.db_path

    db_path = config.get('db', {}).get('path', 'db/wbs.db')
    settings = config.get('settings', {})
    pidfile  = args.pidfile or settings.get('pid_file', 'wbs.pid')
    logfile  = args.logfile or _log_cfg.get('file', 'logs/wbs.log')

    if args.seed:
        from src.db import init_db, seed_db
        async def _seed():
            await init_db(db_path)
            await seed_db(db_path, config)
            log.info("Database seeded. Continuing startup...")
        asyncio.run(_seed())

    if not Path(db_path).exists():
        print(f"ERROR: database not found at {db_path}", file=sys.stderr)
        print("       Run './wbs --seed' first to initialize.", file=sys.stderr)
        sys.exit(1)

    log.info(f"Launching WBS {__version__}")
    if not args.foreground:
        daemonize(logfile)
        write_pidfile(pidfile)

    EXIT_OK = 0 

    def _spawn_core(config, config_path, args, core_q, irc_q) -> Process:
        p = Process(
            target=core_process_launcher,
            args=(config, config_path, args, core_q, irc_q),
            daemon=False,
            name="Core"
        )
        p.start()
        return p

    def _spawn_irc(config, core_q, irc_q) -> Process:
        p = Process(
            target=irc_process_launcher,
            args=(config, core_q, irc_q, None),
            daemon=False,
            name="IRC"
        )
        p.start()
        return p

    core_q = Queue()
    irc_q  = Queue()

    core_proc = _spawn_core(config, str(config_path), args, core_q, irc_q)
    irc_proc  = _spawn_irc(config, core_q, irc_q)

    sentinels = {
        core_proc.sentinel: ("core", core_proc),
        irc_proc.sentinel:  ("irc",  irc_proc),
    }

    try:
        while True:
            ready = mp_wait(list(sentinels.keys()), timeout=30.0)

            for s in ready:
                name, proc = sentinels.pop(s)
                code = proc.exitcode
                log.info(f"{name} exited with code {code}")

                if name == "core":
                    if code == EXIT_OK:
                        # Clean shutdown — stop IRC and exit supervisor
                        log.info("Core clean exit — shutting down supervisor")
                        irc_proc.terminate()
                        irc_proc.join(timeout=3.0)
                        sys.exit(0)
                    else:
                        # Restart (2), rehash (3), or crash — relaunch Core only
                        log.info(f"Relaunching Core (exit code={code})...")
                        core_proc = _spawn_core(config, str(config_path), args, core_q, irc_q)
                        sentinels[core_proc.sentinel] = ("core", core_proc)

                elif name == "irc":
                    # IRC should never self-exit — always relaunch
                    log.warning(f"IRC process died (code={code}), relaunching...")
                    irc_proc = _spawn_irc(config, core_q, irc_q)
                    sentinels[irc_proc.sentinel] = ("irc", irc_proc)

    finally:
        if not args.foreground:
            remove_pidfile(pidfile)

if __name__ == '__main__':
    main()